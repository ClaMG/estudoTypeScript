<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige"
    tools:context=".ui.user.profile.ProfileActivity">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="303dp"
        android:layout_height="104dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/img_logo_straight" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="30dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10"
        app:layout_constraintVertical_bias="0.18">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="10dp"
                android:layout_weight="0"
                android:scaleType="fitCenter"
                android:tint="@color/blueDark"
                app:srcCompat="@drawable/ic_user" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/textUseField"
                android:textColor="@color/blueDark"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUser_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:text="@string/erro_profile"
                android:textColor="@color/blue"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:id="@+id/view4"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="20dp"
            android:background="@color/blueDark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="10dp"
                android:layout_weight="0"
                android:scaleType="fitCenter"
                android:tint="@color/blueDark"
                app:srcCompat="@drawable/ic_user" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/textNameField"
                android:textColor="@color/blueDark"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvName_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:text="@string/erro_profile"
                android:textColor="@color/blue"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:id="@+id/view3"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="20dp"
            android:background="@color/blueDark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView10"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="10dp"
                android:layout_weight="0"
                android:scaleType="fitCenter"
                android:tint="@color/blueDark"
                app:srcCompat="@drawable/ic_email" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/textEmailField"
                android:textColor="@color/blueDark"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:text="@string/erro_profile"
                android:textColor="@color/blue"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:id="@+id/view2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="20dp"
            android:background="@color/blueDark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView11"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="10dp"
                android:layout_weight="0"
                android:scaleType="fitCenter"
                android:tint="@color/blueDark"
                app:srcCompat="@drawable/ic_password" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:text="@string/textPasswordField"
                android:textColor="@color/blueDark"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPassword_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:text="@string/erro_profile"
                android:textColor="@color/blue"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:id="@+id/view5"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/blueDark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnGetUsers_profile"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_weight="0"
                    android:background="@drawable/bg_btn_orange"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:tint="@color/beige"
                    android:visibility="visible"
                    app:srcCompat="@drawable/ic_users" />

                <ImageButton
                    android:id="@+id/btnGetPets_profile"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="0"
                    android:background="@drawable/bg_btn_orange"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:tint="@color/beige"
                    app:srcCompat="@drawable/ic_animal" />

                <ImageButton
                    android:id="@+id/btnUpdate_profile"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="0"
                    android:background="@drawable/bg_btn_orange"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:tint="@color/beige"
                    app:srcCompat="@drawable/ic_update" />

                <ImageButton
                    android:id="@+id/btnDelete_profile"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="0"
                    android:background="@drawable/bg_btn_orange"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:tint="@color/beige"
                    app:srcCompat="@drawable/ic_delete" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llBtnLogOut_profile"
                android:layout_width="200dp"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_orange"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView13"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_weight="0"
                    android:src="@drawable/ic_logout"
                    android:tint="@color/beige" />

                <Button
                    android:id="@+id/btnLogOut_profile"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:backgroundTint="@android:color/transparent"
                    android:gravity="center"
                    android:text="@string/textLogOutField"
                    android:textColor="@color/beige"
                    android:textSize="16sp"
                    app:cornerRadius="0dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/textTitleProfile"
        android:textColor="@color/orange"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView6" />
</androidx.constraintlayout.widget.ConstraintLayout>