{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", // <-- Mude de "node" para "bundler"
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false, // <-- Mude para FALSE para facilitar os imports
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"], 
  "exclude": ["node_modules", "dist"]

}
